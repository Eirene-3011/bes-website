# ─── Backend API URL ──────────────────────────────────────
# For local development the Vite proxy handles /api automatically,
# so leave this blank (or comment it out) during local dev.
#
# For Netlify deployment, set this to your Render backend URL:
VITE_API_URL=https://your-bes-api.onrender.com
VITE_API_URL=http://localhost:5000/api